{
    "name": "braedenbeaulieu-portfolio",
    "compatibility_date": "2025-04-01",
    "main": "src/index.ts",
    "assets": {
        "directory": "dist",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1
        }
    }
}