---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="404 — Page Not Found"
  description="This page could not be found."
>
  <div class="section-container flex flex-col items-center justify-center min-h-[80vh] text-center gap-6">
    <p class="text-8xl font-black text-accent">404</p>
    <h1 class="text-3xl font-bold text-text tracking-tight">Page not found</h1>
    <p class="text-muted max-w-sm">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 bg-accent text-bg font-bold px-6 py-3 rounded-xl hover:bg-highlight transition-colors duration-200 text-sm mt-2"
    >
      ← Back home
    </a>
  </div>
</BaseLayout>
