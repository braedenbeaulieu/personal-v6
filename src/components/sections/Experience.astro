---
import SectionHeading from '../ui/SectionHeading.astro'

interface Role {
  company: string
  title: string
  period: string
  location: string
  description: string
  highlights: string[]
}

const roles: Role[] = [
  {
    company: 'Elev8 Web Studio',
    title: 'Full-Stack Developer',
    period: '2019 – Present',
    location: 'Remote',
    description: 'Designing and developing scalable, custom WordPress solutions for clients across diverse industries, with a focus on performance, maintainability, and tailored business functionality. Collaborate closely with my team and the client to translate requirements into robust implementations.',
    highlights: [
      'Architected and delivered custom WordPress themes and plugins for marketing agencies, nonprofits, and small-to-mid-sized businesses, improving site performance, flexibility, and user experience',
      'Developed and extended integrations with GiveWP and WooCommerce, enabling advanced donation workflows and e-commerce functionality',
      'Diagnosed and rehabilitated legacy or abandoned WordPress projects, resolving security vulnerabilities, and performance bottlenecks',
      'Implemented custom REST API endpoints and third-party integrations to connect WordPress platforms with external services',
      'Championed web accessibility (WCAG 2.1 AA) across projects — conducting audits, implementing semantic HTML and ARIA patterns, and ensuring keyboard and screen reader compatibility',
      'Optimized frontend performance using modern JavaScript, CSS, and best practices (Core Web Vitals, responsive design, Lighthouse audits)',
    ],
  },
  {
    company: 'School',
    title: 'Internet Applications & Web Development',
    period: '2016 – 2019',
    location: 'St. Clair College',
    description: 'Completed a comprehensive web development program covering both frontend and backend technologies, with hands-on experience building real-world applications using modern frameworks and programming paradigms.',
    highlights: [
      'Built full-stack applications using technologies such as Angular, Laravel, and ASP.NET, gaining experience in MVC architecture and API-driven development',
      'Collaborated in team-based projects using version control and agile-style workflows to deliver functional web applications',
      'Strengthened problem-solving and debugging skills through iterative development and peer code reviews',
      'Competed in Skills Ontario Web Development competitions, earning a medal and demonstrating strong practical and competitive coding ability',
    ],
  },
]
---

<section id="experience" class="py-24 md:py-32 border-t border-border" aria-labelledby="experience-heading">
  <div class="section-container">
    <SectionHeading label="03 / Experience" heading="Where I've worked" headingId="experience-heading" />

    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-0 top-0 bottom-0 w-px bg-border hidden md:block" aria-hidden="true"></div>

      <div class="flex flex-col gap-12 md:gap-16">
        {roles.map((role, i) => (
          <article class="relative md:pl-12" aria-label={`${role.title} at ${role.company}`}>
            <!-- Timeline dot -->
            <div
              class="absolute left-0 top-1 -translate-x-1/2 w-3 h-3 rounded-full bg-accent border-2 border-bg hidden md:block"
              aria-hidden="true"
            ></div>

            <div class="grid md:grid-cols-[200px_1fr] gap-4 md:gap-10">
              <!-- Date + Company -->
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.15em] text-muted mb-1">
                  <span class="screen-reader-text">{`From ${role.period.replace('–', 'to')}`}</span>
                  <span aria-hidden="true">{role.period}</span>
                </p>
                <p class="text-sm text-muted">
                  <span class="screen-reader-text">{`Location: ${role.location}`}</span>
                  <span aria-hidden="true">{role.location}</span>
                </p>
              </div>

              <!-- Role details -->
              <div>
                <h3 class="text-xl font-bold text-text tracking-tight mb-0.5">
                  {role.title}
                </h3>
                <p class="text-accent font-semibold text-sm mb-3">
                  <span class="screen-reader-text">{`Company: ${role.company}`}</span>
                  <span aria-hidden="true">{role.company}</span>
                </p>
                <p class="text-muted text-[0.9375rem] leading-relaxed mb-4">
                  {role.description}
                </p>
                <ul class="space-y-2" aria-label="Highlights">
                  {role.highlights.map((highlight) => (
                    <li class="flex gap-3 text-sm text-muted leading-relaxed">
                      <span class="text-accent mt-0.5 shrink-0" aria-hidden="true">▸</span>
                      {highlight}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
