---
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center pt-16"
  aria-label="Introduction"
>
  <!-- Background texture -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-accent/5 rounded-full blur-2xl soft-pulse soft-pulse-delay-1"></div>
    <div class="absolute bottom-1/4 left-0 w-64 h-64 bg-highlight/3 rounded-full blur-2xl soft-pulse soft-pulse-slow soft-pulse-delay-2"></div>
  </div>

  <div class="section-container relative">
    <p class="text-xs font-bold uppercase tracking-[0.25em] text-accent mb-6 fade-up">
      Full-Stack Developer
    </p>

    <h1 class="display-text text-text mb-8 fade-up fade-up-delay-1">
      Braeden<br />
      <span class="text-text">Beaulieu<span class="text-accent">.</span></span>
    </h1>

    <p class="text-lg md:text-xl text-muted max-w-xl leading-relaxed mb-12 fade-up fade-up-delay-2">
      I build WordPress sites and plugins for clients, and I'm passionate about continuous learning and exploring new technologies.
    </p>

    <div class="flex flex-wrap gap-4 fade-up fade-up-delay-3">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 bg-accent text-bg font-bold px-6 py-3 rounded-xl hover:bg-highlight transition-colors duration-200 text-sm"
      >
        View My Work
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      {
        // hiding this for now
        false && (
          <a
            href="mailto:hello@braedenbeaulieu.com"
            class="inline-flex items-center gap-2 border border-border text-text font-bold px-6 py-3 rounded-xl hover:border-accent/50 hover:text-accent transition-colors duration-200 text-sm"
          >
            Get in Touch
          </a>
        )
      }
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-12 left-0 fade-up fade-up-delay-3 hidden md:flex items-center gap-3" aria-hidden="true">
      <div class="w-px h-12 bg-gradient-to-b from-accent to-transparent"></div>
      <span class="text-xs uppercase tracking-[0.15em] text-muted" style="writing-mode: vertical-rl;">Scroll</span>
    </div>
  </div>
</section>
