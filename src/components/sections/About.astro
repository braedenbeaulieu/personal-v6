---
import SectionHeading from '../ui/SectionHeading.astro'
import TechTag from '../ui/TechTag.astro'

const technologies = [
  'WordPress',
  'PHP',
  'SCSS',
  'JavaScript',
  'TypeScript',
  'Vue',
  'Nuxt',
  'Astro',
  'Tailwind CSS',
]
---

<section id="about" class="py-24 md:py-32 border-t border-border">
  <div class="section-container">
    <SectionHeading label="02 / About" heading="A bit about me" />

    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
      <!-- Bio -->
      <div class="space-y-5 text-[1.0625rem] leading-relaxed">
        <p class="text-text/85">
          I work on a WordPress-exclusive web agency building complex, fully custom sites for
          clients — custom themes, bespoke plugins, and deep integrations
          with many of the most popular plugins like The Events Calendar, Gravity Forms, WooCommerce, and GiveWP.
        </p>
        <p class="text-text/85">
          Outside of work, I keep up with newer frameworks for the joy of it. Vue, Nuxt, Astro,
          Cloudflare Pages — hobby projects that keep my perspective sharp and my skills current.
        </p>
        <p class="text-text/85">
          I care about code that's maintainable and readable, whatever the stack — and I'm drawn
          to the craft of building things that are genuinely fast, accessible and well-considered.
        </p>
        {
          // hiding this for now, no need for it
          false && (
            <div class="pt-4">
              <a
                href="mailto:hello@braedenbeaulieu.com"
                class="inline-flex items-center gap-2 text-accent font-semibold text-sm hover:text-highlight transition-colors duration-200"
              >
                Let's work together →
              </a>
            </div>
          )
        }
      </div>

      <!-- Tech grid -->
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-muted mb-6">
          Technologies
        </p>
        <div class="flex flex-wrap gap-2">
          {technologies.map((tech) => (
            <TechTag tag={tech} variant="accent" />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
