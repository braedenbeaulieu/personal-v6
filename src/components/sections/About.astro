---
import SectionHeading from '../ui/SectionHeading.astro'
import TechTag from '../ui/TechTag.astro'

const technologies = [
  'WordPress',
  'PHP',
  'SCSS',
  'JavaScript',
  'TypeScript',
  'Vue',
  'Nuxt',
  'Astro',
  'Tailwind CSS',
]
---

<section id="about" class="py-24 md:py-32 border-t border-border" aria-labelledby="about-heading">
  <div class="section-container">
    <SectionHeading label="02 / About" heading="A bit about me" headingId="about-heading" />

    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
      <!-- Bio -->
      <div class="space-y-5 text-[1.0625rem] leading-relaxed">
        <p class="text-text/85">
          I work at a web agency that specializes in WordPress — building complex, fully custom sites for
          clients with custom themes, bespoke plugins, and deep integrations
          with plugins like The Events Calendar, Gravity Forms, WooCommerce, and GiveWP.
        </p>
        <p class="text-text/85">
          Outside of work, I explore newer parts of the stack for fun — Vue, Nuxt, Astro,
          edge runtimes — hobby projects that keep my thinking sharp.
        </p>
        <p class="text-text/85">
          I care about code that's maintainable and readable, whatever the stack — and I'm drawn
          to the craft of building things that are genuinely fast, accessible and well-considered.
        </p>
        {
          // hiding this for now, no need for it
          false && (
            <div class="pt-4">
              <a
                href="mailto:hello@braedenbeaulieu.com"
                class="inline-flex items-center gap-2 text-accent font-semibold text-sm hover:text-highlight transition-colors duration-200"
              >
                Let's work together →
              </a>
            </div>
          )
        }
      </div>

      <!-- Tech grid -->
      <div>
        <p id="tech-label" class="text-xs font-bold uppercase tracking-[0.2em] text-muted mb-6">
          Technologies
        </p>
        <ul class="flex flex-wrap gap-2 list-none" role="list" aria-labelledby="tech-label">
          {technologies.map((tech) => (
            <li><TechTag tag={tech} variant="accent" /></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
