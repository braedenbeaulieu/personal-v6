---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, tags } = post.data

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<article class="group flex flex-col h-full border border-border rounded-2xl p-6 bg-surface hover:border-accent/30 transition-colors duration-300" aria-labelledby={`post-title-${post.id}`}>
  <div class="flex flex-wrap gap-2 mb-4">
    {tags.slice(0, 3).map((tag) => (
      <span class="text-xs font-semibold uppercase tracking-wider text-accent">
        {tag}
      </span>
    ))}
  </div>

  <h3 id={`post-title-${post.id}`} class="text-lg font-bold tracking-tight text-text mb-2 group-hover:text-accent transition-colors duration-200 leading-snug">
    <a href={`/blog/${post.id}`} class="stretched-link">
      {title}
    </a>
  </h3>

  <p class="text-muted text-sm leading-relaxed mb-4 line-clamp-2">{description}</p>

  <div class="mt-auto flex items-center justify-between">
    <time class="text-xs text-muted" datetime={pubDate.toISOString()}>
      {formattedDate}
    </time>
    <span class="text-xs font-semibold text-accent group-hover:gap-2 flex items-center gap-1 transition-all duration-200" aria-hidden="true">
      Read →
    </span>
  </div>
</article>

<style>
  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  article {
    position: relative;
  }
</style>
