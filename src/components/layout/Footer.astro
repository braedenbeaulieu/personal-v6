---
const year = new Date().getFullYear()
---

<footer class="border-t border-border mt-24">
  <div class="section-container py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-muted">
        &copy; {year} Braeden Beaulieu. Built with Astro.
      </p>
      <div class="flex items-center gap-6">
        <a
          href="https://github.com/braedenbeaulieu"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted hover:text-text transition-colors duration-200"
          aria-label="GitHub"
        >
          GitHub
        </a>
        <a
          href="https://ca.linkedin.com/in/braedenbeaulieu"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted hover:text-text transition-colors duration-200"
          aria-label="LinkedIn"
        >
          LinkedIn
        </a>
        {
          false && (
            <a
              href="mailto:hello@braedenbeaulieu.com"
              class="text-sm text-muted hover:text-text transition-colors duration-200"
              aria-label="Email"
            >
              Email
            </a>
          )
        }
      </div>
    </div>
  </div>
</footer>
