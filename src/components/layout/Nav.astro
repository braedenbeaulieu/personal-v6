---
const navLinks = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  // { href: '/blog', label: 'Blog' },
]
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-transparent" id="site-nav">
  <div class="section-container">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href="/"
        class="font-black text-4xl tracking-tighter text-text hover:text-accent transition-colors duration-200"
        aria-label="Braeden Beaulieu — Home"
      >
        BB<span class="text-accent">.</span>
      </a>

      <!-- Desktop links -->
      <nav aria-label="Site">
        <ul class="hidden md:flex items-center gap-8 list-none">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="font-medium text-muted hover:text-text transition-colors duration-200 relative group"
              >
                {label}
                <span class="absolute -bottom-0.5 left-0 w-0 h-px bg-accent transition-all duration-200 group-hover:w-full"></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile nav (no JS) -->
      <details class="md:hidden group">
        <summary
          class="cursor-pointer list-none p-2 text-muted hover:text-text transition-colors duration-200"
          aria-label="Toggle menu"
        >
          <svg
            class="block group-open:hidden w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            class="hidden group-open:block w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </summary>
        <div class="absolute top-full left-0 right-0 bg-bg border-b border-border px-6 py-4">
          <ul class="flex flex-col gap-4 list-none" role="list">
            {navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-base font-medium text-muted hover:text-text transition-colors duration-200"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Scroll-aware nav border — CSS-only approach with IntersectionObserver fallback
  const nav = document.getElementById('site-nav')
  if(nav) {
    const update = () => {
      if(window.scrollY > 16) {
        nav.style.borderColor = 'var(--color-border)'
        nav.style.backgroundColor = 'color-mix(in srgb, var(--color-bg) 90%, transparent)'
        nav.style.backdropFilter = 'blur(12px)'
      } else {
        nav.style.borderColor = 'transparent'
        nav.style.backgroundColor = ''
        nav.style.backdropFilter = ''
      }
    }
    window.addEventListener('scroll', update, { passive: true })
    update()
  }
</script>
